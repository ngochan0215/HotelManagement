@startuml Chat_Sequence_Diagram
title Sequence Diagram: Chat with Person

skinparam backgroundColor #FAFAFA
skinparam participant {
  BackgroundColor #EEF2FF
  BorderColor #6366F1
  FontColor #1E1B4B
}
skinparam actor {
  BackgroundColor #FFF7ED
  BorderColor #EA580C
}
skinparam sequence {
  ArrowColor #6366F1
  LifeLineBorderColor #A5B4FC
  LifeLineBackgroundColor #EEF2FF
  GroupBorderColor #E2E8F0
  GroupFontColor #475569
  GroupBodyBackgroundColor #F8FAFC
  DividerBackgroundColor #E2E8F0
}
skinparam note {
  BackgroundColor #F0FDF4
  BorderColor #16A34A
  FontColor #166534
}
skinparam database {
  BackgroundColor #FFF7ED
  BorderColor #D97706
}

actor "User A\n(Người gửi)" as UserA
actor "User B\n(Người nhận)" as UserB

box "Client Browser A" #F8FAFC
  participant "React App A\n(chatPage.jsx)" as FEA
end box

box "Client Browser B" #FFF7ED
  participant "React App B\n(chatPage.jsx)" as FEB
end box

participant "API Gateway\n:3000" as GW

box "Chat-Service :3014" #EEF2FF
  participant "HTTP Layer\n(chatRoute + Controller)" as ChatHTTP
  participant "Socket.io Layer\n(initSocket.js)" as ChatWS
  participant "ChatService\n(chatService.js)" as ChatSvc
end box

participant "User-Service\n(via RabbitMQ)" as UserSvc

database "MongoDB\nchat_db" as DB

' ════════════════════════════════════════════════════════
== 1. KHỞI TẠO KẾT NỐI SOCKET ==
' ════════════════════════════════════════════════════════

UserA -> FEA: Mở trang /chat (đã đăng nhập)
activate FEA

FEA -> ChatWS: io.connect("ws://localhost:3014")\n{ auth: { token: localStorage.getItem("token") } }
activate ChatWS

note over ChatWS: socketAuth middleware\njwt.verify(token, JWT_SECRET)\n→ socket.user = { id, role }

ChatWS -> UserSvc: eventBus.safeRequest(\n  GET_USER_INFO, { userId }\n)
activate UserSvc
UserSvc --> ChatWS: { _id, email, avatar, system_role }
deactivate UserSvc

ChatWS -> ChatWS: socket.userSnapshot = {\n  user_id, name: email,\n  avatar, role\n}

ChatWS -> DB: Conversation.find(\n  { "participants.user_id": userId },\n  { _id: 1 }\n)
activate DB
DB --> ChatWS: [convId1, convId2, ...]
deactivate DB

ChatWS -> ChatWS: socket.join("user:{userId}")\nloop convIds: socket.join("conv:{id}")

note over ChatWS: Broadcast "chat:user_online"\nnếu đây là kết nối đầu tiên của user

ChatWS --> FEA: event: connect
FEA --> UserA: Chat sẵn sàng

note over UserB, FEB: User B kết nối socket theo cùng luồng trên\n(song song, rút gọn)
UserB -> FEB: Mở trang /chat
FEB -> ChatWS: io.connect(...) [tương tự User A]
ChatWS --> FEB: event: connect

' ════════════════════════════════════════════════════════
== 2. TẢI DANH SÁCH CUỘC TRÒ CHUYỆN ==
' ════════════════════════════════════════════════════════

FEA -> GW: GET /chat/conversations\nAuthorization: Bearer {JWT}
activate GW

GW -> ChatHTTP: proxy → GET /conversations
activate ChatHTTP

note over ChatHTTP: verifyToken middleware\njwt.verify → req.user = { id, role }

ChatHTTP -> ChatSvc: getMyConversations(userId)
activate ChatSvc

ChatSvc -> DB: Conversation.find(\n  { "participants.user_id": userId }\n).sort({ "last_message.sent_at": -1 }).lean()
activate DB
DB --> ChatSvc: conversations[]
deactivate DB

ChatSvc --> ChatHTTP: conversations[]
deactivate ChatSvc

ChatHTTP --> GW: 200 { success: true, conversations }
deactivate ChatHTTP

GW --> FEA: conversations[]
deactivate GW

FEA --> UserA: Sidebar hiển thị\ndanh sách cuộc trò chuyện

' ════════════════════════════════════════════════════════
== 3. TẠO CUỘC TRÒ CHUYỆN TRỰC TIẾP MỚI ==
' ════════════════════════════════════════════════════════

UserA -> FEA: Nhấn "+", nhập userId của User B\nnhấn "Go"

FEA -> GW: POST /chat/conversations\n{ type: "direct", target_user_id: userBId }
activate GW

GW -> ChatHTTP: proxy → POST /conversations
activate ChatHTTP

ChatHTTP -> ChatSvc: getOrCreateDirectConversation(\n  myId, myRole, targetId\n)
activate ChatSvc

ChatSvc -> ChatSvc: pair_key = sort([myId, targetId]).join("_")

ChatSvc -> DB: Conversation.findOne({ pair_key })
activate DB
DB --> ChatSvc: null (chưa tồn tại)
deactivate DB

ChatSvc -> UserSvc: eventBus.safeRequest(\n  GET_USER_INFO, { userId: targetId }\n)
activate UserSvc
UserSvc --> ChatSvc: { _id, system_role, ... }
deactivate UserSvc

ChatSvc -> DB: Conversation.create({\n  type: "direct",\n  pair_key,\n  participants: [\n    { user_id: myId, role: myRole },\n    { user_id: targetId, role: targetRole }\n  ],\n  created_by: myId\n})
activate DB
DB --> ChatSvc: newConversation
deactivate DB

ChatSvc --> ChatHTTP: { conversation, isNew: true }
deactivate ChatSvc

ChatHTTP --> GW: 201 { success: true, conversation }
deactivate ChatHTTP

GW --> FEA: conversation object
deactivate GW

FEA -> FEA: setConversations([conv, ...prev])\nsetActiveConvId(conv._id)

FEA -> ChatWS: emit("chat:join_conversation"\n{ conversation_id })
ChatWS -> ChatWS: socket.join("conv:{conversation_id}")
note over ChatWS: User A giờ đã trong phòng\n"conv:{id}" để nhận messages real-time

' ════════════════════════════════════════════════════════
== 4. TẢI TIN NHẮN KHI MỞ CUỘC TRÒ CHUYỆN ==
' ════════════════════════════════════════════════════════

FEA -> GW: GET /chat/conversations/{id}/messages\n?page=1&limit=50
activate GW

GW -> ChatHTTP: proxy → GET /conversations/{id}/messages
activate ChatHTTP

ChatHTTP -> ChatSvc: getMessages(convId, userId, page, limit)
activate ChatSvc

ChatSvc -> DB: Conversation.findOne(\n  { _id: convId, "participants.user_id": userId }\n)\n[assertParticipant]
activate DB
DB --> ChatSvc: conversation (hoặc throw 403)
deactivate DB

ChatSvc -> DB: Message.find({ conversation_id })\n.sort({ created_at: -1 })\n.skip((page-1)*limit).limit(limit)\n.lean()
activate DB
DB --> ChatSvc: messages[] (newest first)
deactivate DB

ChatSvc -> ChatSvc: messages.reverse()\n(oldest-first để hiển thị đúng)

ChatSvc --> ChatHTTP: messages[]
deactivate ChatSvc

ChatHTTP --> GW: 200 { success: true, messages, page, limit }
deactivate ChatHTTP
GW --> FEA: messages[]
deactivate GW

FEA --> UserA: Hiển thị thread tin nhắn\n(auto-scroll to bottom)

' ════════════════════════════════════════════════════════
== 5. GỬI VÀ NHẬN TIN NHẮN (REAL-TIME) ==
' ════════════════════════════════════════════════════════

UserA -> FEA: Nhập "Xin chào!" và nhấn Enter
FEA -> ChatWS: emit("chat:send_message" {\n  conversation_id,\n  content: "Xin chào!"\n})
activate ChatWS

ChatWS -> ChatSvc: sendMessage(\n  convId, socket.userSnapshot,\n  "Xin chào!", "text"\n)
activate ChatSvc

ChatSvc -> DB: Conversation.findOne({ _id: convId,\n  "participants.user_id": senderId\n})\n[assertParticipant]
activate DB
DB --> ChatSvc: OK
deactivate DB

ChatSvc -> DB: Message.create({\n  conversation_id: convId,\n  sender_id: userA_id,\n  sender_name: "a@hotel.com",  ← snapshot\n  sender_avatar: null,\n  sender_role: "receptionist",\n  content: "Xin chào!",\n  type: "text",\n  read_by: [{ user_id: userA, read_at: now }]\n})
activate DB
DB --> ChatSvc: savedMessage
deactivate DB

ChatSvc -> DB: Conversation.findByIdAndUpdate(convId, {\n  last_message: {\n    content: "Xin chào!",\n    sender_id: userA_id,\n    sender_name: "a@hotel.com",\n    sent_at: message.created_at\n  }\n})
activate DB
DB --> ChatSvc: OK
deactivate DB

ChatSvc --> ChatWS: savedMessage
deactivate ChatSvc

ChatWS -> ChatWS: io.to("conv:{id}").emit(\n  "chat:new_message",\n  { conversation_id, message: savedMessage }\n)

note over ChatWS: Broadcast tới TẤT CẢ sockets\ntrong phòng "conv:{id}"\n(kể cả socket của User A)

ChatWS --> FEA: event "chat:new_message"\n{ conversation_id, message }
deactivate ChatWS

ChatWS --> FEB: event "chat:new_message"\n{ conversation_id, message }

FEA -> FEA: activeConvIdRef.current === convId?\n→ setMessages([...prev, message])\n(isMine=true → căn phải, màu indigo)

FEB -> FEB: activeConvIdRef.current === convId?\n→ setMessages([...prev, message])\n(isMine=false → căn trái, nền trắng)

FEB --> UserB: Hiển thị tin nhắn mới\n"Xin chào!" từ User A

' ════════════════════════════════════════════════════════
== 6. TYPING INDICATOR (TÙY CHỌN) ==
' ════════════════════════════════════════════════════════

UserB -> FEB: Bắt đầu gõ phản hồi
FEB -> ChatWS: emit("chat:typing"\n{ conversation_id })
ChatWS -> FEA: socket.to("conv:{id}").emit(\n  "chat:typing",\n  { conversation_id, user_id: B, user_name: "b@hotel.com" }\n)
FEA --> UserA: Hiển thị "đang nhập..."

UserB -> FEB: Dừng gõ / gửi tin
FEB -> ChatWS: emit("chat:stop_typing"\n{ conversation_id })
ChatWS -> FEA: socket.to("conv:{id}").emit("chat:stop_typing"\n{ conversation_id, user_id: B })
FEA --> UserA: Ẩn "đang nhập..."

' ════════════════════════════════════════════════════════
== 7. ĐÁNH DẤU ĐÃ ĐỌC ==
' ════════════════════════════════════════════════════════

UserA -> FEA: Đọc tin nhắn mới (mở conversation)
FEA -> ChatWS: emit("chat:mark_read"\n{ conversation_id })
activate ChatWS

ChatWS -> ChatSvc: markAsRead(convId, userA_id)
activate ChatSvc

ChatSvc -> DB: Message.updateMany({\n  conversation_id: convId,\n  "read_by.user_id": { $ne: userA_id }\n}, {\n  $push: { read_by: { user_id: userA_id, read_at: now } }\n})
activate DB
DB --> ChatSvc: { modifiedCount: n }
deactivate DB

ChatSvc --> ChatWS: read_at timestamp
deactivate ChatSvc

ChatWS -> FEB: socket.to("conv:{id}").emit(\n  "chat:read_receipt",\n  { conversation_id, user_id: userA_id, read_at }\n)
deactivate ChatWS

FEB --> UserB: Cập nhật trạng thái đã đọc

' ════════════════════════════════════════════════════════
== 8. NGẮT KẾT NỐI ==
' ════════════════════════════════════════════════════════

UserA -> FEA: Đóng tab / thoát
FEA -> ChatWS: socket.disconnect()
activate ChatWS

ChatWS -> ChatWS: onlineUsers.get(userId).delete(socketId)

alt Không còn kết nối nào khác của User A
  ChatWS -> ChatWS: onlineUsers.delete(userId)
  ChatWS -> FEB: io.emit("chat:user_offline"\n{ user_id: userA_id })
  FEB --> UserB: User A offline
end

deactivate ChatWS
deactivate FEA

@enduml
